# Optional. Google Lens matches inside the app (https://serpapi.com, free tier available).
# Without it, image forensics and the one-click reverse-search links still work.
SERPAPI_API_KEY=

# Where reports and image thumbnails are stored (default: ./data)
# FI_DATA_DIR=./data

# Parallel requests and per-request timeout in seconds
# FI_CONCURRENCY=8
# FI_TIMEOUT=12

# Largest image accepted, in MB
# FI_MAX_IMAGE_MB=15
